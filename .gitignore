node_modules/
.env
.env.*
!.env.example

# SQLite, including the write-ahead log and shared-memory sidecar files.
# The bare *.db pattern does NOT cover these, and the WAL holds real page data —
# it had captured webhook payloads with personal details in it.
*.db
*.db-*
*.sqlite
*.sqlite-*

*.log
simulation.db
demo.db
VIDEO-SCRIPT.md

# Regenerated on every run — snapshot deliberately if you want a record.
# Anchored with a leading slash so only the working copies at the repo root are
# ignored. Without it these match at every depth and silently swallow anything
# under src/eval/snapshots/, which is the one place a record is meant to live.
/eval_results.json
/judge_results.json
/judge_planted_results.json

# A separate project that was copied in here by accident, 1.1 GB of it.
# Ignored so a stray `git add -A` cannot write it into history, where it would
# be permanent. The real fix is to move it out of this tree.
src/delivery/vk-staff-system/
