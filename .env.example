# Razorpay test-mode credentials (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard > Account & Settings > Webhooks. You choose this string when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=

PORT=3000
DB_PATH=./second-chance.db

# Optional. Without it, recovery messages use deterministic templates instead of
# being written by a model. Free key at console.groq.com
GROQ_API_KEY=

# Optional override. A small model is deliberate: two-sentence output against a
# supplied brief, with correctness enforced by validation rather than by model
# capability. Move to openai/gpt-oss-120b if the validator rejection rate climbs.
COMPOSER_MODEL=openai/gpt-oss-20b

# Delivery. Without DELIVERY=email nothing is sent; messages are only logged, so
# a development loop cannot contact anybody.
DELIVERY=console
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM=

# The merchant the recovery is sent on behalf of: the From display name, and the
# name shown in the email. Without it the recipient sees a bare Gmail address
# telling them a payment failed, which is the shape of a phishing attempt.
MERCHANT_NAME=Second Chance

# Every message goes here instead of the address on the payment. Captured real
# failures carry the email of whoever was at that checkout, and replaying them
# locally must not mail those people. Leave set unless genuinely in production.
DELIVERY_REDIRECT_TO=you@gmail.com

# Basic-auth password for the dashboard and /api. Unset means open, which is fine
# on a laptop and not fine anywhere reachable — they return customer addresses,
# payment ids and every composed message.
DASHBOARD_PASSWORD=

# Interface to bind. Loopback by default; set 0.0.0.0 to expose on the network,
# and set DASHBOARD_PASSWORD if you do.
HOST=127.0.0.1
