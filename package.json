{
  "name": "second-chance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recovers failed payments on Razorpay by diagnosing why they failed and choosing how to ask again.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "replay": "tsx scripts/replay.ts",
    "setup:secret": "node scripts/set-webhook-secret.mjs",
    "redeliver": "tsx scripts/redeliver.ts",
    "taxonomy": "tsx scripts/taxonomy.ts",
    "reclassify": "tsx scripts/reclassify.ts",
    "export-fixtures": "node scripts/export-fixtures.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
